{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "prisma/**/*.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": [
        "node_modules",
        "debug-*.ts",
        "**/debug-*.ts",
        "scripts/**/*",
        "test-setup.ts",
        "**/*.test.ts",
        "**/*.spec.ts",
        "__tests__/**/*",
        "cloudflare-worker/**/*",
        "hayattan",
        "hayattan 2",
        ".claude",
        ".next/cache/**/*"
    ]
}
