# ============================================
# HAYATTAN.NET - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (local): postgresql://postgres:password@localhost:5432/hayattan
# Example (Vercel): Use Vercel Postgres connection string from dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/hayattan"

# ============================================
# AUTHENTICATION (NextAuth v5)
# ============================================
# Generate a random secret: openssl rand -base64 32
# MUST be at least 32 characters
AUTH_SECRET="your-super-secret-key-min-32-characters-long"

# İlk yönetici hesabını oluştururken kullanılır:
# ADMIN_EMAIL="yonetici@example.com"
# ADMIN_PASSWORD="GucluBirSifre2026"
# ADMIN_NAME="Site Yöneticisi"

# Site URL (required for OAuth callbacks)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# GÖRSEL YÜKLEME (Ücretsiz)
# ============================================
# Local: Dosya public/uploads'a kaydedilir. Token gerekmez.
# Vercel deploy: Projede Storage → Blob store oluşturun; BLOB_READ_WRITE_TOKEN otomatik eklenir (ücretsiz kota).
# İsterseniz sadece URL de yapıştırabilirsiniz (Imgur vb.).
# BLOB_READ_WRITE_TOKEN=""   # Sadece Vercel'de deploy ediyorsanız (opsiyonel)

# ============================================
# RATE LIMITING (Vercel KV - Optional for Dev)
# ============================================
# Get from: https://vercel.com/dashboard/stores
# Uses Upstash Redis under the hood
# Not required for local development (will fallback to in-memory)
KV_REST_API_URL="https://your-kv-instance.upstash.io"
KV_REST_API_TOKEN="your-kv-token"

# ============================================
# SITE CONFIGURATION
# ============================================
# Public URL of your site (for SEO, Open Graph, etc.)
# Make sure to update this in production!
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Site name (appears in metadata, emails, etc.)
NEXT_PUBLIC_SITE_NAME="Hayattan.Net"

# ============================================
# E-POSTA / RESEND
# ============================================
# Resend panelinden bir API anahtarı oluşturun ve hayattan.net alan adını doğrulayın.
# Bu değerleri yerelde .env dosyasına, production'da Vercel Environment Variables'a ekleyin.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Hayattan.Net <noreply@hayattan.net>"

# ============================================
# ANALYTICS (Optional)
# ============================================
# Google Analytics Measurement ID
# Format: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console HTML etiketi doğrulama kodu (yalnızca content değeri)
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features in different environments
# NEXT_PUBLIC_ENABLE_COMMENTS="false"

# ============================================
# DEBUGGING & DEVELOPMENT
# ============================================
# Set to "true" to enable debug logs
# DEBUG="false"

# Prisma logging level (info, query, warn, error)
# PRISMA_LOG_LEVEL="warn"
